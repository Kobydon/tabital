# Copy to .env for local development. On Render, set these as environment variables.
# Never commit a real .env file.

# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# postgresql://USER:PASSWORD@HOST/DBNAME  (defaults to local sqlite:///app.db when unset)
DATABASE_URL=

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:4200,https://app.tabitalpay.com

# 1 only on a developer machine
FLASK_DEBUG=0

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Paystack: test keys from Paystack Dashboard > Settings > API Keys & Webhooks.
# Only the secret key is used by the server. Never commit real keys.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:4200/customer/payment-callback
# Webhook URL to set in the Paystack dashboard: https://<your-api-host>/webhooks/paystack

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
